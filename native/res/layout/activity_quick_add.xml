<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qa_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="22dp">

    <LinearLayout android:id="@+id/qa_card" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center" android:background="@drawable/widget_bg"
        android:orientation="vertical" android:padding="16dp">

        <TextView android:id="@+id/qa_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#F3EEE6" android:textSize="18sp" android:textStyle="bold" />

        <EditText android:id="@+id/qa_input" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:background="@drawable/widget_row_bg"
            android:imeOptions="actionDone" android:inputType="textCapSentences" android:maxLength="120"
            android:maxLines="1" android:paddingStart="12dp" android:paddingEnd="12dp"
            android:paddingTop="12dp" android:paddingBottom="12dp"
            android:textColor="#F3EEE6" android:textColorHint="#8E99AB" android:textSize="15sp" />

        <EditText android:id="@+id/qa_body" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:background="@drawable/widget_row_bg"
            android:gravity="top" android:hint="Write your note\u2026" android:inputType="textCapSentences|textMultiLine"
            android:minLines="3" android:maxLines="6" android:paddingStart="12dp" android:paddingEnd="12dp"
            android:paddingTop="12dp" android:paddingBottom="12dp"
            android:textColor="#F3EEE6" android:textColorHint="#8E99AB" android:textSize="14sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:gravity="end" android:orientation="horizontal">
            <TextView android:id="@+id/qa_cancel" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:padding="12dp" android:text="Cancel" android:textColor="#8E99AB"
                android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/qa_add" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:background="@drawable/widget_btn_bg"
                android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="11dp" android:paddingBottom="11dp"
                android:text="Add" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
